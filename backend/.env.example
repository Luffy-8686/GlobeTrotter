# Backend Environment Variables
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_here

# Supabase PostgreSQL Database (Transaction pooler for app)
# You can find this in Supabase -> Project Settings -> Database -> Connection string -> URI (pooler, transaction mode)
DATABASE_URL="postgres://[db-user]:[db-password]@aws-0-[region].pooler.supabase.com:6543/[db-name]?pgbouncer=true"

# Supabase PostgreSQL Database (Direct connection for Prisma migrations)
# You can find this in Supabase -> Project Settings -> Database -> Connection string -> URI (session mode)
DIRECT_URL="postgres://[db-user]:[db-password]@aws-0-[region].pooler.supabase.com:5432/[db-name]"
