<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- Create Trip Page (Screen 3)                                         -->
    <!-- ================================================================== -->
    <template id="gt_create_trip_page" name="GlobeTrotter Create Trip">
        <t t-call="globetrotter.gt_portal_layout">
            <div class="gt-create-trip-page">
                <h1 class="gt-h1">Plan a New Trip ✨</h1>
                <p class="gt-text-muted gt-mb-4">Fill in the details below to start building your itinerary.</p>

                <t t-if="error" t-as="error">
                    <div class="gt-toast gt-toast--error gt-mb-3" style="position:static;">
                        <span t-esc="error"/>
                    </div>
                </t>

                <form action="/globetrotter/trip/create" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- Cover Photo Upload -->
                    <div class="gt-form-group">
                        <label class="gt-label">Cover Photo</label>
                        <label class="gt-cover-upload" id="gt-cover-upload">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                                <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>
                            </svg>
                            <span class="gt-text-small">Click to upload a cover photo</span>
                            <input type="file" name="cover_image" accept="image/*"
                                   onchange="if(this.files[0]){this.parentElement.querySelector('img')?.remove();var i=document.createElement('img');i.src=URL.createObjectURL(this.files[0]);this.parentElement.appendChild(i)}"/>
                        </label>
                    </div>

                    <!-- Trip Name -->
                    <div class="gt-form-group">
                        <label class="gt-label" for="trip-name">Trip Name <span class="gt-required">*</span></label>
                        <input type="text" class="gt-input" id="trip-name" name="name"
                               placeholder="e.g., European Summer 2026"
                               t-att-value="values.get('name', '') if values else ''"
                               required="required"/>
                    </div>

                    <!-- Date Range -->
                    <div class="gt-flex gt-gap-2">
                        <div class="gt-form-group" style="flex:1;">
                            <label class="gt-label" for="start-date">Start Date <span class="gt-required">*</span></label>
                            <input type="date" class="gt-input" id="start-date" name="start_date"
                                   t-att-value="values.get('start_date', '') if values else ''"
                                   required="required"/>
                        </div>
                        <div class="gt-form-group" style="flex:1;">
                            <label class="gt-label" for="end-date">End Date <span class="gt-required">*</span></label>
                            <input type="date" class="gt-input" id="end-date" name="end_date"
                                   t-att-value="values.get('end_date', '') if values else ''"
                                   required="required"/>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="gt-form-group">
                        <label class="gt-label" for="description">Description</label>
                        <textarea class="gt-textarea" id="description" name="description"
                                  placeholder="What's this trip about? Any special plans or goals?"
                                  rows="4"><t t-if="values" t-esc="values.get('description', '')"/></textarea>
                    </div>

                    <!-- Actions -->
                    <div class="gt-flex gt-gap-2 gt-mt-4">
                        <a href="/globetrotter" class="gt-btn gt-btn--ghost">Cancel</a>
                        <button type="submit" class="gt-btn gt-btn--primary gt-btn--lg" style="flex:1;">
                            Create Trip &amp; Add Stops →
                        </button>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <!-- ================================================================== -->
    <!-- Itinerary Builder Page (Screen 4/5)                                 -->
    <!-- ================================================================== -->
    <template id="gt_itinerary_builder_page" name="GlobeTrotter Itinerary Builder">
        <t t-call="globetrotter.gt_portal_layout">
            <div class="gt-flex gt-justify-between gt-items-center gt-mb-3">
                <div>
                    <h1 class="gt-h1 gt-mb-0"><t t-esc="trip.name"/></h1>
                    <p class="gt-text-muted">
                        <t t-esc="trip.start_date"/> — <t t-esc="trip.end_date"/>
                        · <t t-esc="trip.total_days"/> days
                        · <span class="gt-text-secondary">₹<t t-esc="'{:,.0f}'.format(trip.total_budget)"/></span>
                    </p>
                </div>
                <div class="gt-flex gt-gap-2">
                    <a t-att-href="'/globetrotter/trip/%s' % trip.id" class="gt-btn gt-btn--secondary gt-btn--sm">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        View
                    </a>
                    <a t-att-href="'/globetrotter/trip/%s/budget' % trip.id" class="gt-btn gt-btn--secondary gt-btn--sm">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        Budget
                    </a>
                </div>
            </div>

            <!-- OWL Component Mount Point -->
            <div id="gt-itinerary-builder-root" t-att-data-trip-id="trip.id">
                <owl-component name="globetrotter.ItineraryBuilder"/>
            </div>
        </t>
    </template>

    <!-- ================================================================== -->
    <!-- Itinerary View Page (Screen 6)                                      -->
    <!-- ================================================================== -->
    <template id="gt_itinerary_view_page" name="GlobeTrotter Itinerary View">
        <t t-call="globetrotter.gt_portal_layout">
            <div class="gt-flex gt-justify-between gt-items-center gt-mb-3">
                <div>
                    <h1 class="gt-h1 gt-mb-0"><t t-esc="trip.name"/></h1>
                    <p class="gt-text-muted">
                        <t t-esc="trip.start_date"/> — <t t-esc="trip.end_date"/>
                        · <t t-esc="trip.destination_count"/> destinations
                        · <span class="gt-text-secondary">₹<t t-esc="'{:,.0f}'.format(trip.total_budget)"/></span>
                    </p>
                </div>
                <div class="gt-flex gt-gap-2">
                    <a t-att-href="'/globetrotter/trip/%s/edit' % trip.id" class="gt-btn gt-btn--secondary gt-btn--sm">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        Edit
                    </a>
                    <a t-att-href="'/globetrotter/trip/%s/budget' % trip.id" class="gt-btn gt-btn--secondary gt-btn--sm">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        Budget
                    </a>
                </div>
            </div>

            <!-- Stops Overview -->
            <div class="gt-flex gt-gap-2 gt-mb-4 gt-overflow-x-auto">
                <t t-foreach="trip.stop_ids" t-as="stop">
                    <div class="gt-chip">
                        📍 <t t-esc="stop.city_name"/>
                        <span class="gt-text-small">(<t t-esc="stop.duration_days"/>d)</span>
                    </div>
                </t>
            </div>

            <!-- Day-wise Itinerary -->
            <div class="gt-itinerary-view">
                <t t-if="days_data">
                    <t t-foreach="days_data" t-as="day">
                        <div class="gt-day-group">
                            <div class="gt-day-header">
                                <span>Day <t t-esc="day['day']"/></span>
                                <span class="gt-text-secondary">₹<t t-esc="'{:,.0f}'.format(day['total_cost'])"/></span>
                            </div>
                            <t t-foreach="day['activities']" t-as="sa">
                                <div class="gt-activity-row">
                                    <div class="gt-activity-time">
                                        <t t-esc="dict(sa._fields['time_slot'].selection).get(sa.time_slot, '')"/>
                                    </div>
                                    <div>
                                        <div class="gt-activity-name"><t t-esc="sa.activity_name"/></div>
                                        <div class="gt-text-small gt-text-muted">
                                            <t t-esc="dict(sa.activity_id._fields['category'].selection).get(sa.activity_category, '')"/>
                                            · <t t-esc="sa.activity_duration"/>h
                                        </div>
                                    </div>
                                    <div class="gt-activity-cost">₹<t t-esc="'{:,.0f}'.format(sa.final_cost)"/></div>
                                </div>
                            </t>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div class="gt-empty-state">
                        <svg class="gt-empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <h3 class="gt-empty-state-title">No activities planned yet</h3>
                        <p class="gt-empty-state-message">Start building your itinerary by adding stops and activities.</p>
                        <a t-att-href="'/globetrotter/trip/%s/edit' % trip.id" class="gt-btn gt-btn--primary">Open Builder</a>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- ================================================================== -->
    <!-- Budget Page (Screen 9)                                              -->
    <!-- ================================================================== -->
    <template id="gt_budget_page" name="GlobeTrotter Budget">
        <t t-call="globetrotter.gt_portal_layout">
            <div class="gt-flex gt-justify-between gt-items-center gt-mb-3">
                <div>
                    <h1 class="gt-h1 gt-mb-0">Budget &amp; Costs</h1>
                    <p class="gt-text-muted"><t t-esc="trip.name"/></p>
                </div>
                <a t-att-href="'/globetrotter/trip/%s' % trip.id" class="gt-btn gt-btn--secondary gt-btn--sm">← Back to Trip</a>
            </div>

            <!-- OWL Chart Component -->
            <div id="gt-budget-chart-root" t-att-data-trip-id="trip.id" t-att-data-budget="budget_data">
                <owl-component name="globetrotter.BudgetChart"/>
            </div>
        </t>
    </template>
</odoo>
