<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="globetrotter.ItineraryBuilder">
        <div class="gt-itinerary-builder" t-ref="root">
            <!-- Loading State -->
            <t t-if="state.loading">
                <div class="gt-skeleton gt-skeleton--card gt-mb-3" t-foreach="[1,2,3]" t-as="i" t-key="i">
                    <div class="gt-skeleton gt-skeleton-image"/>
                    <div class="gt-skeleton gt-skeleton-text gt-mt-2 gt-mx-2"/>
                    <div class="gt-skeleton gt-skeleton-text gt-skeleton-text--short gt-mx-2 gt-mb-2"/>
                </div>
            </t>

            <t t-else="">
                <!-- Stop Cards -->
                <t t-foreach="state.stops" t-as="stop" t-key="stop.id">
                    <div class="gt-stop-card"
                         t-att-class="{'gt-stop-card--dragging': state.draggedStopId === stop.id}"
                         draggable="true"
                         t-on-dragstart="(ev) => this.onDragStartStop(ev, stop.id)"
                         t-on-dragend="onDragEndStop"
                         t-on-dragover="onDragOverStop"
                         t-on-drop="(ev) => this.onDropStop(ev, stop.id)">
                        <!-- Stop Header (Collapsed) -->
                        <div class="gt-stop-card-header" t-on-click="() => this.toggleStop(stop.id)">
                            <div class="gt-stop-drag-handle" title="Drag to reorder">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="18" x2="16" y2="18"/></svg>
                            </div>
                            <div class="gt-stop-info">
                                <div class="gt-stop-city-name">
                                    📍 <t t-esc="stop.city_name"/>
                                    <span class="gt-text-small gt-text-muted" t-if="stop.city_country"> · <t t-esc="stop.city_country"/></span>
                                </div>
                                <div class="gt-stop-dates" t-if="stop.arrival_date">
                                    <t t-esc="stop.arrival_date"/> → <t t-esc="stop.departure_date"/>
                                    <span t-if="stop.duration_days"> · <t t-esc="stop.duration_days"/> days</span>
                                </div>
                            </div>
                            <div class="gt-stop-budget">
                                <t t-esc="this.formatCost(stop.stop_budget)"/>
                            </div>
                            <span class="gt-chip gt-chip--primary" style="font-size:11px;">
                                <t t-esc="stop.activity_count"/> activities
                            </span>
                            <button class="gt-btn gt-btn--icon" t-on-click.stop="() => this.deleteStop(stop.id)" title="Remove stop">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            </button>
                        </div>

                        <!-- Stop Body (Expanded) -->
                        <div class="gt-stop-card-body" t-att-class="{'expanded': this.isExpanded(stop.id)}">
                            <!-- Activities List -->
                            <t t-if="stop.activities.length > 0">
                                <t t-foreach="stop.activities" t-as="sa" t-key="sa.id">
                                    <div class="gt-activity-row" style="padding:8px 0;">
                                        <div class="gt-activity-time gt-text-small">
                                            <t t-esc="this.getCategoryEmoji(sa.activity_category)"/>
                                            <t t-esc="this.getTimeSlotLabel(sa.time_slot)"/>
                                        </div>
                                        <div style="flex:1;">
                                            <div class="gt-activity-name"><t t-esc="sa.activity_name"/></div>
                                            <div class="gt-text-small gt-text-muted">
                                                <t t-esc="sa.duration_hours"/>h
                                            </div>
                                        </div>
                                        <span class="gt-activity-cost"><t t-esc="this.formatCost(sa.final_cost)"/></span>
                                        <button class="gt-btn gt-btn--icon gt-btn--sm" t-on-click="() => this.removeActivity(sa.id)" title="Remove">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        </button>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <p class="gt-text-muted gt-text-small gt-py-2">No activities yet. Add some below!</p>
                            </t>

                            <!-- Add Activity Button -->
                            <button class="gt-btn gt-btn--secondary gt-btn--sm gt-mt-2"
                                    t-on-click="() => this.openActivityPicker(stop.id, stop.city_id)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                Add Activity
                            </button>
                        </div>
                    </div>
                </t>

                <!-- Add Stop Button -->
                <button class="gt-add-stop-btn gt-mt-2" t-on-click="openCitySearch">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Add another Section
                </button>

                <!-- City Search Modal -->
                <t t-if="state.showCitySearch">
                    <div class="gt-modal-scrim" t-on-click="closeCitySearch">
                        <div class="gt-modal" t-on-click.stop="">
                            <div class="gt-modal-header">
                                <h3 class="gt-modal-title">Select a City</h3>
                                <button class="gt-btn gt-btn--icon" t-on-click="closeCitySearch">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </div>
                            <div class="gt-modal-body">
                                <div class="gt-search-input gt-mb-3">
                                    <svg class="gt-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                    <input type="text" placeholder="Search cities..." t-on-input="onCitySearchInput" autofocus="true"/>
                                </div>
                                <t t-foreach="state.cityResults" t-as="city" t-key="city.id">
                                    <div class="gt-flex gt-items-center gt-gap-2 gt-py-1 gt-cursor-pointer"
                                         style="padding:12px;border-radius:8px;transition:background 150ms;"
                                         t-on-click="() => this.selectCity(city.id)"
                                         onmouseover="this.style.background='var(--gt-surface)'"
                                         onmouseout="this.style.background='transparent'">
                                        <div style="flex:1;">
                                            <div class="gt-text-semibold"><t t-esc="city.name"/></div>
                                            <div class="gt-text-small gt-text-muted"><t t-esc="city.country"/> · <t t-esc="city.activity_count"/> activities</div>
                                        </div>
                                        <span class="gt-cost-index gt-text-small"><t t-esc="'$'.repeat(parseInt(city.cost_index || '1'))"/></span>
                                    </div>
                                </t>
                                <t t-if="state.citySearchQuery.length >= 2 and state.cityResults.length === 0">
                                    <p class="gt-text-muted gt-text-center gt-py-3">No cities found.</p>
                                </t>
                                <t t-if="state.citySearchQuery.length &lt; 2">
                                    <p class="gt-text-muted gt-text-center gt-py-3">Type at least 2 characters to search...</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Activity Picker Modal -->
                <t t-if="state.showActivityPicker">
                    <div class="gt-modal-scrim" t-on-click="closeActivityPicker">
                        <div class="gt-modal" t-on-click.stop="" style="max-width:560px;">
                            <div class="gt-modal-header">
                                <h3 class="gt-modal-title">Add Activities</h3>
                                <button class="gt-btn gt-btn--icon" t-on-click="closeActivityPicker">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </div>
                            <div class="gt-modal-body">
                                <div class="gt-search-input gt-mb-3">
                                    <svg class="gt-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                    <input type="text" placeholder="Search activities..." t-on-input="onActivitySearchInput"/>
                                </div>
                                <t t-foreach="state.activityResults" t-as="activity" t-key="activity.id">
                                    <div class="gt-flex gt-items-center gt-gap-2 gt-py-1"
                                         style="padding:12px;border-radius:8px;border-bottom:1px solid var(--gt-border);">
                                        <div style="flex:1;">
                                            <div class="gt-text-semibold">
                                                <t t-esc="this.getCategoryEmoji(activity.category)"/>
                                                <t t-esc="activity.name"/>
                                            </div>
                                            <div class="gt-text-small gt-text-muted">
                                                <t t-esc="activity.duration_hours"/>h · <t t-esc="this.formatCost(activity.estimated_cost)"/>
                                            </div>
                                        </div>
                                        <t t-if="this.isActivityAdded(state.showActivityPicker.stopId, activity.id)">
                                            <span class="gt-chip" style="font-size:12px;">✓ Added</span>
                                        </t>
                                        <t t-else="">
                                            <button class="gt-btn gt-btn--primary gt-btn--sm"
                                                    t-on-click="() => this.addActivity(activity.id)">
                                                + Add
                                            </button>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="state.activityResults.length === 0">
                                    <p class="gt-text-muted gt-text-center gt-py-3">No activities found for this city.</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
