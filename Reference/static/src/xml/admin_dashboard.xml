<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="globetrotter.AdminDashboard">
        <div class="gt-admin-dashboard gt-p-4">
            <h1 class="gt-h1">GlobeTrotter Analytics</h1>

            <t t-if="state.loading">
                <div class="gt-admin-stats-row">
                    <div class="gt-skeleton" style="height:100px;border-radius:12px;" t-foreach="[1,2,3,4]" t-as="i" t-key="i"/>
                </div>
            </t>
            <t t-else="">
                <!-- Stats Row -->
                <div class="gt-admin-stats-row">
                    <div class="gt-admin-stat-card">
                        <div class="gt-admin-stat-value"><t t-esc="state.stats.trips"/></div>
                        <div class="gt-admin-stat-label">Total Trips</div>
                    </div>
                    <div class="gt-admin-stat-card">
                        <div class="gt-admin-stat-value"><t t-esc="state.stats.users"/></div>
                        <div class="gt-admin-stat-label">Registered Users</div>
                    </div>
                    <div class="gt-admin-stat-card">
                        <div class="gt-admin-stat-value"><t t-esc="state.stats.cities"/></div>
                        <div class="gt-admin-stat-label">Cities</div>
                    </div>
                    <div class="gt-admin-stat-card">
                        <div class="gt-admin-stat-value"><t t-esc="state.stats.activities"/></div>
                        <div class="gt-admin-stat-label">Activities</div>
                    </div>
                </div>

                <!-- Charts -->
                <div class="gt-admin-chart-grid">
                    <div class="gt-chart-container">
                        <h3 class="gt-chart-title">Most Popular Destinations</h3>
                        <canvas t-ref="activityChart"/>
                    </div>
                    <div class="gt-chart-container">
                        <h3 class="gt-chart-title">Top Activities</h3>
                        <t t-if="state.popularActivities.length > 0">
                            <t t-foreach="state.popularActivities" t-as="act" t-key="act_index">
                                <div class="gt-flex gt-justify-between gt-items-center gt-py-1" style="border-bottom:1px solid var(--gt-border,#E5E5E5);">
                                    <span><t t-esc="act_index + 1"/>. <t t-esc="act.name"/></span>
                                    <span class="gt-chip" style="font-size:12px;"><t t-esc="act.count"/> uses</span>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <p style="color:#767676;text-align:center;padding:24px;">No activity data yet.</p>
                        </t>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
