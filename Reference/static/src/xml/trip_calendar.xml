<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="globetrotter.TripCalendar">
        <div class="gt-calendar-page">
            <!-- Month Navigation -->
            <div class="gt-flex gt-justify-between gt-items-center gt-mb-3">
                <button class="gt-btn gt-btn--icon" t-on-click="prevMonth">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <h2 class="gt-h2 gt-mb-0"><t t-esc="this.monthName"/></h2>
                <button class="gt-btn gt-btn--icon" t-on-click="nextMonth">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>

            <!-- Calendar Grid -->
            <div class="gt-calendar-grid">
                <!-- Week day headers -->
                <t t-foreach="this.weekDays" t-as="day" t-key="day">
                    <div class="gt-calendar-header-cell"><t t-esc="day"/></div>
                </t>

                <!-- Day cells -->
                <t t-foreach="this.calendarDays" t-as="day" t-key="day_index">
                    <div t-att-class="'gt-calendar-cell' + (day.isToday ? ' gt-calendar-cell--today' : '') + (!day.num ? ' gt-calendar-cell--disabled' : '')">
                        <t t-if="day.num">
                            <div class="gt-calendar-day-num"><t t-esc="day.num"/></div>
                            <t t-foreach="day.trips" t-as="trip" t-key="trip.id">
                                <div class="gt-calendar-trip-pill"
                                     t-on-click="() => this.goToTrip(trip.id)"
                                     t-att-title="trip.name">
                                    <t t-esc="trip.name"/>
                                </div>
                            </t>
                        </t>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
