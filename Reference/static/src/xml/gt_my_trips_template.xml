<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- My Trips Page (Screen 7)                                            -->
    <!-- ================================================================== -->
    <template id="gt_my_trips_page" name="GlobeTrotter My Trips">
        <t t-call="globetrotter.gt_portal_layout">
            <div class="gt-flex gt-justify-between gt-items-center gt-mb-3">
                <h1 class="gt-h1 gt-mb-0">My Trips</h1>
                <a href="/globetrotter/trip/create" class="gt-btn gt-btn--primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    New Trip
                </a>
            </div>

            <!-- Tabs: Ongoing / Upcoming / Completed -->
            <div class="gt-tabs" role="tablist">
                <button class="gt-tab" role="tab"
                        t-attf-class="gt-tab #{'active' if active_tab == 'ongoing' else ''}"
                        onclick="document.querySelectorAll('.gt-tab').forEach(t=>t.classList.remove('active'));this.classList.add('active');document.querySelectorAll('.gt-tab-panel').forEach(p=>p.classList.remove('active'));document.getElementById('tab-ongoing').classList.add('active');"
                        aria-selected="true">
                    🟢 Ongoing (<t t-esc="len(ongoing_trips)"/>)
                </button>
                <button class="gt-tab" role="tab"
                        t-attf-class="gt-tab #{'active' if active_tab == 'upcoming' else ''}"
                        onclick="document.querySelectorAll('.gt-tab').forEach(t=>t.classList.remove('active'));this.classList.add('active');document.querySelectorAll('.gt-tab-panel').forEach(p=>p.classList.remove('active'));document.getElementById('tab-upcoming').classList.add('active');">
                    📅 Upcoming (<t t-esc="len(upcoming_trips)"/>)
                </button>
                <button class="gt-tab" role="tab"
                        t-attf-class="gt-tab #{'active' if active_tab == 'completed' else ''}"
                        onclick="document.querySelectorAll('.gt-tab').forEach(t=>t.classList.remove('active'));this.classList.add('active');document.querySelectorAll('.gt-tab-panel').forEach(p=>p.classList.remove('active'));document.getElementById('tab-completed').classList.add('active');">
                    ✅ Completed (<t t-esc="len(completed_trips)"/>)
                </button>
            </div>

            <!-- Ongoing Tab -->
            <div id="tab-ongoing" t-attf-class="gt-tab-panel #{'active' if active_tab == 'ongoing' else ''}">
                <t t-if="ongoing_trips">
                    <div class="gt-grid">
                        <t t-foreach="ongoing_trips" t-as="trip">
                            <t t-call="globetrotter.gt_trip_card_snippet"/>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="gt-empty-state">
                        <svg class="gt-empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <h3 class="gt-empty-state-title">No ongoing trips</h3>
                        <p class="gt-empty-state-message">You're not on any trips right now. Time to plan one!</p>
                        <a href="/globetrotter/trip/create" class="gt-btn gt-btn--primary">Plan a Trip</a>
                    </div>
                </t>
            </div>

            <!-- Upcoming Tab -->
            <div id="tab-upcoming" t-attf-class="gt-tab-panel #{'active' if active_tab == 'upcoming' else ''}">
                <t t-if="upcoming_trips">
                    <div class="gt-grid">
                        <t t-foreach="upcoming_trips" t-as="trip">
                            <t t-call="globetrotter.gt_trip_card_snippet"/>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="gt-empty-state">
                        <svg class="gt-empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <h3 class="gt-empty-state-title">No upcoming trips</h3>
                        <p class="gt-empty-state-message">Start dreaming — plan your next adventure now.</p>
                        <a href="/globetrotter/trip/create" class="gt-btn gt-btn--primary">Plan a Trip</a>
                    </div>
                </t>
            </div>

            <!-- Completed Tab -->
            <div id="tab-completed" t-attf-class="gt-tab-panel #{'active' if active_tab == 'completed' else ''}">
                <t t-if="completed_trips">
                    <div class="gt-grid">
                        <t t-foreach="completed_trips" t-as="trip">
                            <t t-call="globetrotter.gt_trip_card_snippet"/>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="gt-empty-state">
                        <svg class="gt-empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        <h3 class="gt-empty-state-title">No completed trips</h3>
                        <p class="gt-empty-state-message">Your completed adventures will appear here. Go explore!</p>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- ================================================================== -->
    <!-- Reusable Trip Card Snippet                                          -->
    <!-- ================================================================== -->
    <template id="gt_trip_card_snippet" name="Trip Card Snippet">
        <div class="gt-card gt-trip-card">
            <a t-att-href="'/globetrotter/trip/%s' % trip.id" style="text-decoration:none;color:inherit;">
                <t t-if="trip.cover_image">
                    <img t-att-src="'/web/image/gt.trip/%s/cover_image' % trip.id"
                         class="gt-card-image" t-att-alt="trip.name" loading="lazy"/>
                </t>
                <t t-else="">
                    <div class="gt-card-image gt-img-placeholder">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                    </div>
                </t>
            </a>
            <span class="gt-trip-card-badge gt-chip">
                <t t-esc="dict(trip._fields['state'].selection).get(trip.state, 'Draft')"/>
            </span>
            <div class="gt-card-body">
                <h3 class="gt-card-title"><t t-esc="trip.name"/></h3>
                <div class="gt-card-meta">
                    <span><t t-esc="trip.start_date"/> — <t t-esc="trip.end_date"/></span>
                </div>
                <div class="gt-flex gt-justify-between gt-items-center gt-mt-1">
                    <span class="gt-chip gt-chip--primary" style="font-size:11px;">
                        <t t-esc="trip.destination_count"/> stops
                    </span>
                    <span class="gt-text-secondary gt-text-semibold">
                        ₹<t t-esc="'{:,.0f}'.format(trip.total_budget)"/>
                    </span>
                </div>
            </div>
            <div class="gt-card-actions">
                <a t-att-href="'/globetrotter/trip/%s' % trip.id" class="gt-btn gt-btn--ghost gt-btn--sm">View</a>
                <a t-att-href="'/globetrotter/trip/%s/edit' % trip.id" class="gt-btn gt-btn--ghost gt-btn--sm">Edit</a>
                <a t-att-href="'/globetrotter/trip/%s/budget' % trip.id" class="gt-btn gt-btn--ghost gt-btn--sm">Budget</a>
            </div>
        </div>
    </template>

    <!-- ================================================================== -->
    <!-- City Search Page (Screen 8)                                         -->
    <!-- ================================================================== -->
    <template id="gt_city_search_page" name="GlobeTrotter City Search">
        <t t-call="globetrotter.gt_portal_layout">
            <h1 class="gt-h1">Explore Cities 🌍</h1>

            <!-- Search & Filters -->
            <form action="/globetrotter/explore/cities" method="get" class="gt-flex gt-gap-2 gt-mb-4 gt-flex-wrap">
                <div class="gt-search-input" style="flex:2;min-width:200px;">
                    <svg class="gt-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" name="q" t-att-value="search_query" placeholder="Search by city or country..."/>
                </div>
                <select class="gt-select" name="region" style="flex:1;min-width:150px;">
                    <option value="">All Regions</option>
                    <option value="asia" t-att-selected="'selected' if region_filter == 'asia' else None">Asia</option>
                    <option value="europe" t-att-selected="'selected' if region_filter == 'europe' else None">Europe</option>
                    <option value="north_america" t-att-selected="'selected' if region_filter == 'north_america' else None">North America</option>
                    <option value="south_america" t-att-selected="'selected' if region_filter == 'south_america' else None">South America</option>
                    <option value="africa" t-att-selected="'selected' if region_filter == 'africa' else None">Africa</option>
                    <option value="middle_east" t-att-selected="'selected' if region_filter == 'middle_east' else None">Middle East</option>
                    <option value="oceania" t-att-selected="'selected' if region_filter == 'oceania' else None">Oceania</option>
                </select>
                <button type="submit" class="gt-btn gt-btn--secondary">Search</button>
            </form>

            <!-- City Grid -->
            <t t-if="cities">
                <div class="gt-grid">
                    <t t-foreach="cities" t-as="city">
                        <div class="gt-card">
                            <t t-if="city.image">
                                <img t-att-src="'/web/image/gt.city/%s/image' % city.id"
                                     class="gt-card-image" t-att-alt="city.name" loading="lazy"/>
                            </t>
                            <t t-else="">
                                <div class="gt-card-image gt-img-placeholder">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                </div>
                            </t>
                            <div class="gt-card-body">
                                <h3 class="gt-card-title"><t t-esc="city.name"/></h3>
                                <div class="gt-card-meta gt-mb-1">
                                    <span><t t-esc="city.country"/></span>
                                    <span>·</span>
                                    <span class="gt-cost-index"><t t-esc="dict(city._fields['cost_index'].selection).get(city.cost_index, '')"/></span>
                                </div>
                                <div class="gt-flex gt-justify-between gt-items-center">
                                    <div class="gt-popularity-bar" style="width:80px;">
                                        <div class="gt-popularity-bar-fill" t-attf-style="width:#{city.popularity_score}%"/>
                                    </div>
                                    <span class="gt-text-small"><t t-esc="city.activity_count"/> activities</span>
                                </div>
                                <t t-if="city.description">
                                    <p class="gt-text-small gt-text-muted gt-mt-1" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                        <t t-esc="city.description"/>
                                    </p>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
            <t t-else="">
                <div class="gt-empty-state">
                    <svg class="gt-empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <h3 class="gt-empty-state-title">No cities found</h3>
                    <p class="gt-empty-state-message">Try adjusting your search or filters.</p>
                </div>
            </t>
        </t>
    </template>

    <!-- ================================================================== -->
    <!-- Activity Search Page                                                -->
    <!-- ================================================================== -->
    <template id="gt_activity_search_page" name="GlobeTrotter Activity Search">
        <t t-call="globetrotter.gt_portal_layout">
            <h1 class="gt-h1">Explore Activities 🎯</h1>

            <form action="/globetrotter/explore/activities" method="get" class="gt-flex gt-gap-2 gt-mb-4 gt-flex-wrap">
                <div class="gt-search-input" style="flex:2;min-width:200px;">
                    <svg class="gt-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" name="q" t-att-value="search_query" placeholder="Search activities..."/>
                </div>
                <select class="gt-select" name="category" style="flex:1;min-width:150px;">
                    <option value="">All Categories</option>
                    <option value="sightseeing" t-att-selected="'selected' if category_filter == 'sightseeing' else None">🏛️ Sightseeing</option>
                    <option value="food" t-att-selected="'selected' if category_filter == 'food' else None">🍽️ Food</option>
                    <option value="adventure" t-att-selected="'selected' if category_filter == 'adventure' else None">🏔️ Adventure</option>
                    <option value="culture" t-att-selected="'selected' if category_filter == 'culture' else None">🎭 Culture</option>
                    <option value="shopping" t-att-selected="'selected' if category_filter == 'shopping' else None">🛍️ Shopping</option>
                    <option value="nightlife" t-att-selected="'selected' if category_filter == 'nightlife' else None">🌙 Nightlife</option>
                    <option value="nature" t-att-selected="'selected' if category_filter == 'nature' else None">🌿 Nature</option>
                    <option value="wellness" t-att-selected="'selected' if category_filter == 'wellness' else None">🧘 Wellness</option>
                </select>
                <button type="submit" class="gt-btn gt-btn--secondary">Search</button>
            </form>

            <t t-if="activities">
                <div class="gt-grid">
                    <t t-foreach="activities" t-as="activity">
                        <div class="gt-card">
                            <t t-if="activity.image">
                                <img t-att-src="'/web/image/gt.activity/%s/image' % activity.id"
                                     class="gt-card-image gt-card-image--square" t-att-alt="activity.name" loading="lazy"/>
                            </t>
                            <t t-else="">
                                <div class="gt-card-image gt-card-image--square gt-img-placeholder">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
                                </div>
                            </t>
                            <div class="gt-card-body">
                                <h3 class="gt-card-title"><t t-esc="activity.name"/></h3>
                                <div class="gt-card-meta gt-mb-1">
                                    <span class="gt-chip" style="font-size:11px;">
                                        <t t-esc="dict(activity._fields['category'].selection).get(activity.category, '')"/>
                                    </span>
                                </div>
                                <div class="gt-card-meta">
                                    <span>📍 <t t-esc="activity.city_name"/></span>
                                    <span>·</span>
                                    <span>⏱ <t t-esc="activity.duration_hours"/>h</span>
                                    <span>·</span>
                                    <span class="gt-text-secondary gt-text-semibold">₹<t t-esc="'{:,.0f}'.format(activity.estimated_cost)"/></span>
                                </div>
                                <t t-if="activity.description">
                                    <p class="gt-text-small gt-text-muted gt-mt-1" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                        <t t-esc="activity.description"/>
                                    </p>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
            <t t-else="">
                <div class="gt-empty-state">
                    <svg class="gt-empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <h3 class="gt-empty-state-title">No activities found</h3>
                    <p class="gt-empty-state-message">Try adjusting your search or category filter.</p>
                </div>
            </t>
        </t>
    </template>

    <!-- ================================================================== -->
    <!-- Calendar Page (Screen 10)                                           -->
    <!-- ================================================================== -->
    <template id="gt_calendar_page" name="GlobeTrotter Calendar">
        <t t-call="globetrotter.gt_portal_layout">
            <h1 class="gt-h1">Trip Calendar 📅</h1>
            <p class="gt-text-muted gt-mb-4">View all your trips on a calendar timeline.</p>

            <!-- OWL Calendar Component -->
            <div id="gt-calendar-root" t-att-data-trips="trips_json">
                <owl-component name="globetrotter.TripCalendar"/>
            </div>
        </t>
    </template>
</odoo>
