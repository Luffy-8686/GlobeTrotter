<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- GlobeTrotter Portal Layout (wraps all GT portal pages)              -->
    <!-- ================================================================== -->
    <template id="gt_portal_layout" name="GlobeTrotter Portal Layout">
        <t t-call="portal.frontend_layout">
            <div class="gt-page gt-page-wrapper">
                <!-- Top Navbar -->
                <nav class="gt-navbar">
                    <div class="gt-navbar-inner">
                        <a href="/globetrotter" class="gt-navbar-brand">
                            <svg class="gt-navbar-brand-icon" viewBox="0 0 32 32" fill="none">
                                <circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="2"/>
                                <path d="M16 2C16 2 20 10 20 16C20 22 16 30 16 30" stroke="currentColor" stroke-width="1.5"/>
                                <path d="M16 2C16 2 12 10 12 16C12 22 16 30 16 30" stroke="currentColor" stroke-width="1.5"/>
                                <line x1="3" y1="12" x2="29" y2="12" stroke="currentColor" stroke-width="1.5"/>
                                <line x1="3" y1="20" x2="29" y2="20" stroke="currentColor" stroke-width="1.5"/>
                            </svg>
                            GlobeTrotter
                        </a>
                        <div class="gt-navbar-search">
                            <div class="gt-search-input">
                                <svg class="gt-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                <input type="text" placeholder="Search cities, activities..." id="gt-global-search"/>
                            </div>
                        </div>
                        <div class="gt-navbar-actions">
                            <a href="/globetrotter/explore/cities" class="gt-btn gt-btn--ghost gt-btn--sm gt-hidden-mobile">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                Explore
                            </a>
                            <a href="/globetrotter/trip/create" class="gt-btn gt-btn--primary gt-btn--sm gt-hidden-mobile">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                Plan a Trip
                            </a>
                            <a href="/globetrotter/profile" class="gt-navbar-avatar-link">
                                <t t-if="request.env.user.image_128">
                                    <img t-att-src="'/web/image/res.users/%s/image_128' % request.env.user.id"
                                         class="gt-navbar-avatar"
                                         alt="Profile"/>
                                </t>
                                <t t-else="">
                                    <div class="gt-avatar">
                                        <t t-esc="(request.env.user.name or 'U')[0].upper()"/>
                                    </div>
                                </t>
                            </a>
                        </div>
                    </div>
                </nav>

                <!-- Main Content Area -->
                <main class="gt-page-content">
                    <div class="gt-container">
                        <t t-raw="0"/>
                    </div>
                </main>

                <!-- Mobile Bottom Tab Bar -->
                <nav class="gt-bottom-bar">
                    <a href="/globetrotter" class="gt-bottom-bar-item"
                       t-attf-class="gt-bottom-bar-item #{'active' if request.httprequest.path in ['/globetrotter', '/globetrotter/dashboard'] else ''}">
                        <svg class="gt-bottom-bar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        Home
                    </a>
                    <a href="/globetrotter/trips" class="gt-bottom-bar-item"
                       t-attf-class="gt-bottom-bar-item #{'active' if request.httprequest.path == '/globetrotter/trips' else ''}">
                        <svg class="gt-bottom-bar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        My Trips
                    </a>
                    <a href="/globetrotter/explore/cities" class="gt-bottom-bar-item"
                       t-attf-class="gt-bottom-bar-item #{'active' if '/explore' in request.httprequest.path else ''}">
                        <svg class="gt-bottom-bar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        Explore
                    </a>
                    <a href="/globetrotter/community" class="gt-bottom-bar-item"
                       t-attf-class="gt-bottom-bar-item #{'active' if request.httprequest.path == '/globetrotter/community' else ''}">
                        <svg class="gt-bottom-bar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Community
                    </a>
                    <a href="/globetrotter/profile" class="gt-bottom-bar-item"
                       t-attf-class="gt-bottom-bar-item #{'active' if request.httprequest.path == '/globetrotter/profile' else ''}">
                        <svg class="gt-bottom-bar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Profile
                    </a>
                </nav>
            </div>
        </t>
    </template>
</odoo>
