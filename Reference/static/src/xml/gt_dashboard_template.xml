<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- Dashboard Page (Screen 2)                                           -->
    <!-- ================================================================== -->
    <template id="gt_dashboard_page" name="GlobeTrotter Dashboard">
        <t t-call="globetrotter.gt_portal_layout">
            <!-- Welcome Banner -->
            <div class="gt-dashboard-banner">
                <div class="gt-dashboard-banner-content">
                    <h1>Welcome back, <t t-esc="user.name"/>! ✈️</h1>
                    <p>Where will your next adventure take you?</p>
                    <a href="/globetrotter/trip/create" class="gt-btn gt-btn--primary gt-btn--lg" id="gt-plan-trip-cta">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Plan a Trip
                    </a>
                </div>
            </div>

            <!-- Top Regional Selections -->
            <div class="gt-section">
                <div class="gt-section-header">
                    <h2 class="gt-h2 gt-section-title">🌏 Top Destinations</h2>
                    <a href="/globetrotter/explore/cities" class="gt-btn gt-btn--ghost gt-btn--sm">View All</a>
                </div>
                <div class="gt-scroll-row gt-scroll-row--desktop-grid">
                    <t t-foreach="top_cities" t-as="city">
                        <div class="gt-card" style="min-width:260px;">
                            <t t-if="city.image">
                                <img t-att-src="'/web/image/gt.city/%s/image' % city.id"
                                     class="gt-card-image" t-att-alt="city.name" loading="lazy"/>
                            </t>
                            <t t-else="">
                                <div class="gt-card-image gt-img-placeholder">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                </div>
                            </t>
                            <div class="gt-card-body">
                                <h3 class="gt-card-title"><t t-esc="city.name"/></h3>
                                <div class="gt-card-meta">
                                    <span><t t-esc="city.country"/></span>
                                    <span>·</span>
                                    <span class="gt-cost-index"><t t-esc="dict(city._fields['cost_index'].selection).get(city.cost_index, '')"/></span>
                                    <span>·</span>
                                    <span><t t-esc="city.activity_count"/> activities</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Previous Trips -->
            <div class="gt-section">
                <div class="gt-section-header">
                    <h2 class="gt-h2 gt-section-title">🧳 Your Recent Trips</h2>
                    <a href="/globetrotter/trips" class="gt-btn gt-btn--ghost gt-btn--sm">View All</a>
                </div>

                <t t-if="my_trips">
                    <div class="gt-grid">
                        <t t-foreach="my_trips" t-as="trip">
                            <a t-att-href="'/globetrotter/trip/%s' % trip.id" class="gt-card gt-trip-card" style="text-decoration:none;color:inherit;">
                                <t t-if="trip.cover_image">
                                    <img t-att-src="'/web/image/gt.trip/%s/cover_image' % trip.id"
                                         class="gt-card-image" t-att-alt="trip.name" loading="lazy"/>
                                </t>
                                <t t-else="">
                                    <div class="gt-card-image gt-img-placeholder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                                    </div>
                                </t>
                                <span class="gt-trip-card-badge gt-chip">
                                    <t t-esc="dict(trip._fields['state'].selection).get(trip.state, 'Draft')"/>
                                </span>
                                <div class="gt-card-body">
                                    <h3 class="gt-card-title"><t t-esc="trip.name"/></h3>
                                    <div class="gt-card-meta">
                                        <span><t t-esc="trip.start_date"/> — <t t-esc="trip.end_date"/></span>
                                    </div>
                                    <div class="gt-card-meta gt-mt-1">
                                        <span class="gt-chip gt-chip--primary" style="font-size:11px;">
                                            <t t-esc="trip.destination_count"/> destinations
                                        </span>
                                        <span class="gt-text-secondary gt-text-semibold" style="margin-left:auto;">
                                            ₹<t t-esc="'{:,.0f}'.format(trip.total_budget)"/>
                                        </span>
                                    </div>
                                </div>
                            </a>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="gt-empty-state">
                        <svg class="gt-empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                            <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/>
                        </svg>
                        <h3 class="gt-empty-state-title">No trips yet</h3>
                        <p class="gt-empty-state-message">Start planning your first adventure — it only takes a minute!</p>
                        <a href="/globetrotter/trip/create" class="gt-btn gt-btn--primary">Plan Your First Trip</a>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
