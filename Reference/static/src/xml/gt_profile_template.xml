<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- Profile / Settings Page (Screen 12)                                 -->
    <!-- ================================================================== -->
    <template id="gt_profile_page" name="GlobeTrotter Profile">
        <t t-call="globetrotter.gt_portal_layout">
            <div class="gt-profile-page">
                <h1 class="gt-h1">Profile &amp; Settings ⚙️</h1>

                <form action="/globetrotter/profile/update" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- Avatar Section -->
                    <div class="gt-profile-avatar-section">
                        <label class="gt-profile-avatar-upload">
                            <div class="gt-avatar gt-avatar--lg">
                                <t t-if="user.image_128">
                                    <img t-att-src="'/web/image/res.users/%s/image_128' % user.id" alt="Avatar"/>
                                </t>
                                <t t-else="">
                                    <t t-esc="(user.name or 'U')[0].upper()"/>
                                </t>
                            </div>
                            <div class="gt-profile-avatar-overlay">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                            </div>
                            <input type="file" name="avatar" accept="image/*" style="display:none;"/>
                        </label>
                        <div>
                            <h3 class="gt-h3 gt-mb-0"><t t-esc="user.name"/></h3>
                            <p class="gt-text-muted"><t t-esc="user.email"/></p>
                        </div>
                    </div>

                    <!-- Name -->
                    <div class="gt-form-group">
                        <label class="gt-label" for="profile-name">Full Name</label>
                        <input type="text" class="gt-input" id="profile-name" name="name"
                               t-att-value="user.name"/>
                    </div>

                    <!-- Bio -->
                    <div class="gt-form-group">
                        <label class="gt-label" for="profile-bio">Bio</label>
                        <textarea class="gt-textarea" id="profile-bio" name="bio"
                                  placeholder="Tell the world about yourself..."
                                  rows="3"><t t-esc="user.bio or ''"/></textarea>
                    </div>

                    <!-- Travel Preferences -->
                    <div class="gt-form-group">
                        <label class="gt-label" for="profile-prefs">Travel Preferences</label>
                        <input type="text" class="gt-input" id="profile-prefs" name="travel_preferences"
                               t-att-value="user.travel_preferences or ''"
                               placeholder="e.g., adventure, culture, food, beaches"/>
                        <span class="gt-field-help">Comma-separated tags to help us recommend destinations.</span>
                    </div>

                    <!-- Saved Destinations -->
                    <div class="gt-form-group">
                        <label class="gt-label">Saved Destinations</label>
                        <div class="gt-flex gt-gap-1 gt-flex-wrap">
                            <t t-foreach="user.saved_destination_ids" t-as="city">
                                <span class="gt-chip"><t t-esc="city.name"/>, <t t-esc="city.country"/></span>
                            </t>
                            <t t-if="not user.saved_destination_ids">
                                <span class="gt-text-muted gt-text-small">No saved destinations yet. Explore cities to save favourites.</span>
                            </t>
                        </div>
                    </div>

                    <button type="submit" class="gt-btn gt-btn--primary gt-mt-2">Save Changes</button>
                </form>

                <!-- Danger Zone -->
                <div class="gt-danger-zone">
                    <h3 class="gt-danger-zone-title">⚠️ Danger Zone</h3>
                    <p class="gt-text-small gt-text-muted gt-mb-2">Deleting your account is permanent and cannot be undone. All your trips will be deleted.</p>
                    <button type="button" class="gt-btn gt-btn--danger gt-btn--sm"
                            onclick="if(confirm('Are you absolutely sure you want to delete your account? This action cannot be undone.')){window.location='/web/session/logout'}">
                        Delete My Account
                    </button>
                </div>
            </div>
        </t>
    </template>
</odoo>
