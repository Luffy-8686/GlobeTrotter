<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- gt.trip Views                                                       -->
    <!-- ================================================================== -->
    <record id="gt_trip_tree" model="ir.ui.view">
        <field name="name">gt.trip.tree</field>
        <field name="model">gt.trip</field>
        <field name="arch" type="xml">
            <tree string="Trips">
                <field name="name"/>
                <field name="user_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge" decoration-success="state == 'ongoing'" decoration-info="state == 'upcoming'" decoration-muted="state == 'completed'"/>
                <field name="destination_count"/>
                <field name="total_budget" widget="monetary"/>
                <field name="total_days"/>
                <field name="is_shared"/>
            </tree>
        </field>
    </record>

    <record id="gt_trip_form" model="ir.ui.view">
        <field name="name">gt.trip.form</field>
        <field name="model">gt.trip</field>
        <field name="arch" type="xml">
            <form string="Trip">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Trip Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="total_budget"/>
                            <field name="total_days"/>
                            <field name="destination_count"/>
                            <field name="is_shared"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Stops">
                            <field name="stop_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="city_id"/>
                                    <field name="arrival_date"/>
                                    <field name="departure_date"/>
                                    <field name="duration_days"/>
                                    <field name="stop_budget"/>
                                    <field name="activity_count"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Expenses">
                            <field name="expense_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="amount"/>
                                    <field name="date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Share Links">
                            <field name="share_link_ids">
                                <tree>
                                    <field name="token"/>
                                    <field name="is_active"/>
                                    <field name="view_count"/>
                                    <field name="share_url" widget="url"/>
                                    <field name="created_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gt_trip_search" model="ir.ui.view">
        <field name="name">gt.trip.search</field>
        <field name="model">gt.trip</field>
        <field name="arch" type="xml">
            <search string="Search Trips">
                <field name="name"/>
                <field name="user_id"/>
                <filter name="ongoing" string="Ongoing" domain="[('state', '=', 'ongoing')]"/>
                <filter name="upcoming" string="Upcoming" domain="[('state', '=', 'upcoming')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Owner" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- gt.city Views                                                       -->
    <!-- ================================================================== -->
    <record id="gt_city_tree" model="ir.ui.view">
        <field name="name">gt.city.tree</field>
        <field name="model">gt.city</field>
        <field name="arch" type="xml">
            <tree string="Cities">
                <field name="name"/>
                <field name="country"/>
                <field name="region"/>
                <field name="cost_index"/>
                <field name="popularity_score" widget="progressbar"/>
                <field name="activity_count"/>
            </tree>
        </field>
    </record>

    <record id="gt_city_form" model="ir.ui.view">
        <field name="name">gt.city.form</field>
        <field name="model">gt.city</field>
        <field name="arch" type="xml">
            <form string="City">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="City Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="country"/>
                            <field name="region"/>
                            <field name="cost_index"/>
                        </group>
                        <group>
                            <field name="popularity_score"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="activity_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Activities">
                            <field name="activity_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="estimated_cost"/>
                                    <field name="duration_hours"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- gt.activity Views                                                   -->
    <!-- ================================================================== -->
    <record id="gt_activity_tree" model="ir.ui.view">
        <field name="name">gt.activity.tree</field>
        <field name="model">gt.activity</field>
        <field name="arch" type="xml">
            <tree string="Activities">
                <field name="name"/>
                <field name="category"/>
                <field name="city_name"/>
                <field name="estimated_cost"/>
                <field name="duration_hours"/>
            </tree>
        </field>
    </record>

    <record id="gt_activity_form" model="ir.ui.view">
        <field name="name">gt.activity.form</field>
        <field name="model">gt.activity</field>
        <field name="arch" type="xml">
            <form string="Activity">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Activity Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="city_id"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="estimated_cost"/>
                            <field name="duration_hours"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- gt.expense Views                                                    -->
    <!-- ================================================================== -->
    <record id="gt_expense_tree" model="ir.ui.view">
        <field name="name">gt.expense.tree</field>
        <field name="model">gt.expense</field>
        <field name="arch" type="xml">
            <tree string="Expenses">
                <field name="trip_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="amount"/>
                <field name="date"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- gt.share.link Views                                                 -->
    <!-- ================================================================== -->
    <record id="gt_share_link_tree" model="ir.ui.view">
        <field name="name">gt.share.link.tree</field>
        <field name="model">gt.share.link</field>
        <field name="arch" type="xml">
            <tree string="Share Links">
                <field name="trip_id"/>
                <field name="token"/>
                <field name="is_active"/>
                <field name="view_count"/>
                <field name="share_url" widget="url"/>
                <field name="created_date"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Actions                                                             -->
    <!-- ================================================================== -->
    <record id="action_gt_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">gt.trip</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="gt_trip_search"/>
    </record>

    <record id="action_gt_city" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">gt.city</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_gt_activity" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">gt.activity</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_gt_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">gt.expense</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_gt_share_link" model="ir.actions.act_window">
        <field name="name">Share Links</field>
        <field name="res_model">gt.share.link</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
